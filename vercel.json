{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "newpipe-web": {
      "root": "newpipe-web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ytdlp",
          "format": "url",
          "env": "YTDLP_INTERNAL_URL"
        }
      ]
    },
    "ytdlp": {
      "root": "newpipe-web/ytdlp",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "newpipe-web"
      }
    }
  ]
}
