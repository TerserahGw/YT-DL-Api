{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "newpipe-web": {
      "root": "newpipe-web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "EXTRACTOR_BASE_URL"
        }
      ]
    },
    "backend": {
      "root": "newpipe-web/backend",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "newpipe-web"
      }
    }
  ]
}
