# Java NewPipeExtractorAPI with the genuine TeamNewPipe/NewPipeExtractor library.
# Vercel's Container runtime executes this image, not Node.js.
FROM mrtumble/opentube-backend:latest

# Vercel's default container HTTP port is 80.
# The upstream Spring Boot image normally listens on 8080.
ENV SERVER_PORT=80 \
    OPENTUBE_NEWPIPE_COUNTRY=ID \
    OPENTUBE_NEWPIPE_LANGUAGE=id \
    SPRINGDOC_APIDOCS_ENABLED=false \
    SPRINGDOC_SWAGGERUI_ENABLED=false

EXPOSE 80
