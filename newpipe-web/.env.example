# On Vercel: DO NOT set EXTRACTOR_BASE_URL manually.
# The Vercel Services binding in vercel.json injects its private URL automatically.
#
# Optional local development when running `next dev` without `vercel dev`:
EXTRACTOR_BASE_URL=http://127.0.0.1:8080
# Only for a separately secured reverse proxy, not needed in Vercel Services:
# BACKEND_AUTHORIZATION=
