# Optional YouTube cookies, server-side secret. Configure in Vercel Settings.
# YOUTUBE_COOKIE=SID=...; HSID=...; ...
# or:
# YOUTUBE_COOKIES_JSON={"cookie":"SID=...; HSID=..."}
#
# Vercel injects YTDLP_INTERNAL_URL from the web -> ytdlp service binding.
# Never set YTDLP_INTERNAL_URL, EXTRACTOR_BASE_URL or BACKEND_AUTHORIZATION manually.

# Signed same-origin audio/video proxy. REQUIRED to enable /api/media.
# Generate locally: openssl rand -hex 32
# MEDIA_PROXY_SECRET=<your-64-character-random-hex-string>
# A secret is not a user login or bandwidth quota; protect the public API using Vercel Firewall.
